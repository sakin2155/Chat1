/* ===========================
   Global Styles & Reset
   =========================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg-dark: #000000;
    --bg-calculator: #000000;
    --btn-number: #333333;
    --btn-function: #a5a5a5;
    --btn-operator: #ff9f0a;
    --text-white: #ffffff;
    --text-dark: #000000;
    --display-text: #ffffff;

    /* Messenger Colors */
    --messenger-bg: #0a0a0a;
    --sidebar-bg: #1c1c1e;
    --chat-bg: #000000;
    --message-sent: #0084ff;
    --message-received: #3a3a3c;
    --input-bg: #1c1c1e;
    --border-color: #2c2c2e;
    --online-green: #31a24c;
    --typing-gray: #8e8e93;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg-dark);
    color: var(--text-white);
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
    position: fixed;
    top: 0;
    left: 0;
}

.hidden {
    display: none !important;
}

/* ===========================
   Calculator Styles
   =========================== */
#calculator-view {
    width: 100%;
    max-width: 400px;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-calculator);
}

.calculator-container {
    width: 100%;
    max-width: 375px;
    padding: 20px;
}

/* Mobile responsive calculator */
@media (max-width: 480px) {
    .calculator-container {
        padding: 10px;
        max-width: 100%;
    }

    #display {
        font-size: 48px;
    }

    .calculator-display {
        min-height: 100px;
        padding: 20px 15px;
    }

    .calculator-buttons {
        gap: 8px;
    }

    .btn {
        font-size: 28px;
    }

    .btn.zero {
        padding-left: 25px;
    }
}

.calculator-header {
    height: 40px;
    display: flex;
    align-items: center;
    margin-bottom: 20px;
}

.login-icon {
    background: none;
    border: none;
    color: var(--btn-function);
    font-size: 24px;
    cursor: pointer;
    padding: 5px 10px;
    opacity: 0.6;
    transition: opacity 0.2s;
}

.login-icon:hover {
    opacity: 1;
}

.calculator-display {
    background: var(--bg-calculator);
    padding: 30px 20px;
    text-align: right;
    margin-bottom: 20px;
    min-height: 120px;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
}

#display {
    font-size: 64px;
    font-weight: 300;
    color: var(--display-text);
    word-wrap: break-word;
    max-width: 100%;
}

.calculator-buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.btn {
    border: none;
    border-radius: 50%;
    font-size: 32px;
    font-weight: 400;
    cursor: pointer;
    transition: opacity 0.2s;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn:active {
    opacity: 0.5;
}

.btn.number {
    background: var(--btn-number);
    color: var(--text-white);
}

.btn.function {
    background: var(--btn-function);
    color: var(--text-dark);
}

.btn.operator {
    background: var(--btn-operator);
    color: var(--text-white);
}

.btn.zero {
    grid-column: span 2;
    border-radius: 50px;
    aspect-ratio: auto;
    justify-content: flex-start;
    padding-left: 30px;
}

/* ===========================
   Modal Styles
   =========================== */
.modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.modal-content {
    background: var(--sidebar-bg);
    padding: 40px;
    border-radius: 20px;
    max-width: 400px;
    width: 90%;
    position: relative;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
}

.close-modal {
    position: absolute;
    top: 15px;
    right: 20px;
    font-size: 32px;
    cursor: pointer;
    color: var(--btn-function);
    line-height: 1;
}

.modal-content h2 {
    margin-bottom: 25px;
    font-size: 28px;
    font-weight: 600;
}

.modal-content input {
    width: 100%;
    padding: 15px;
    margin-bottom: 15px;
    background: var(--input-bg);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-white);
    font-size: 16px;
}

.modal-content input:focus {
    outline: none;
    border-color: var(--message-sent);
}

.modal-content button {
    width: 100%;
    padding: 15px;
    margin-bottom: 10px;
    background: var(--message-sent);
    border: none;
    border-radius: 10px;
    color: var(--text-white);
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
}

.modal-content button:hover {
    opacity: 0.9;
}

.modal-content button.secondary {
    background: transparent;
    border: 1px solid var(--border-color);
}

.error-message {
    color: #ff3b30;
    margin-top: 15px;
    font-size: 14px;
    text-align: center;
}

/* ===========================
   Chat App Styles
   =========================== */
#chat-app {
    width: 100%;
    height: 100vh;
    background: var(--messenger-bg);
}

.chat-container {
    display: flex;
    height: 100%;
    max-width: 1400px;
    margin: 0 auto;
}

/* User List Sidebar */
.user-list-container {
    width: 100%;
    background: var(--sidebar-bg);
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
}

.chat-header {
    padding: 20px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.chat-header h2 {
    font-size: 28px;
    font-weight: 700;
}

.logout-icon {
    background: none;
    border: none;
    color: var(--btn-function);
    font-size: 24px;
    cursor: pointer;
    padding: 5px 10px;
    transition: opacity 0.2s;
}

.logout-icon:hover {
    opacity: 0.7;
}

.user-list {
    flex: 1;
    overflow-y: auto;
}

.user-item {
    display: flex;
    align-items: center;
    padding: 15px 20px;
    cursor: pointer;
    transition: background 0.2s;
    border-bottom: 1px solid var(--border-color);
}

.user-item:hover {
    background: var(--input-bg);
}

.user-item.active {
    background: var(--input-bg);
}

.user-avatar-container {
    position: relative;
    margin-right: 15px;
}

.user-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 600;
    color: var(--text-white);
}

.online-indicator {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 12px;
    height: 12px;
    background: var(--online-green);
    border: 2px solid var(--sidebar-bg);
    border-radius: 50%;
}

.user-info {
    flex: 1;
}

.user-name {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 3px;
}

.user-status {
    font-size: 13px;
    color: var(--typing-gray);
}

/* Chat Window */
.chat-window-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--chat-bg);
}

.chat-window-header {
    padding: 15px 20px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 15px;
}

.back-btn {
    display: none;
    background: none;
    border: none;
    color: var(--text-white);
    font-size: 24px;
    cursor: pointer;
    padding: 5px;
}

.chat-user-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.chat-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 600;
}

#chat-user-name {
    font-size: 16px;
    font-weight: 600;
}

#chat-user-status {
    font-size: 12px;
    color: var(--typing-gray);
}

/* Messages Container */
.messages-container {
    scroll-behavior: smooth;
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.message {
    display: flex;
    margin-bottom: 8px;
    animation: slideIn 0.2s ease-out;
    position: relative;
}

/* Swipe reply icon indicator */
.message::before {
    content: '↩';
    position: absolute;
    font-size: 24px;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
    top: 50%;
    transform: translateY(-50%);
}

.message.sent::before {
    left: 10px;
    color: var(--message-sent);
}

.message.received::before {
    right: 10px;
    color: var(--text-white);
}

.message.swiping::before {
    opacity: 0.6;
}

/* highlight when jumping to replied message */
.message.highlight-replied .message-bubble {
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.25) inset;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.message.sent {
    justify-content: flex-end;
}

.message.received {
    justify-content: flex-start;
}

.message-bubble {
    max-width: 70%;
    padding: 12px 16px;
    border-radius: 18px;
    position: relative;
    word-wrap: break-word;
}

@media (max-width: 480px) {
    .message-bubble {
        max-width: 85%;
    }
}

.message.sent .message-bubble {
    display: flex;
    align-items: center;
    gap: 3px;
}

.message-options-trigger {
    position: absolute;
    top: 5px;
    right: 5px;
    background: rgba(0, 0, 0, 0.3);
    border: none;
    color: var(--text-white);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 12px;
    display: none;
}

.message:hover .message-options-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Typing Indicator */
.typing-indicator {
    padding: 10px 20px;
}

.typing-dots {
    display: flex;
    gap: 4px;
    padding: 12px 16px;
    background: var(--message-received);
    border-radius: 18px;
    width: fit-content;
}

.typing-dots span {
    width: 8px;
    height: 8px;
    background: var(--typing-gray);
    border-radius: 50%;
    animation: typing 1.4s infinite;
}

.typing-dots span:nth-child(2) {
    animation-delay: 0.2s;
}

.typing-dots span:nth-child(3) {
    animation-delay: 0.4s;
}

@keyframes typing {

    0%,
    60%,
    100% {
        opacity: 0.3;
        transform: translateY(0);
    }

    30% {
        opacity: 1;
        transform: translateY(-10px);
    }
}

/* Message Input */
.message-input-container {
    padding: 15px 20px;
    border-top: 1px solid var(--border-color);
    display: flex;
    gap: 10px;
    align-items: center;
}

.icon-btn {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    padding: 8px;
    transition: opacity 0.2s;
}

.icon-btn:hover {
    opacity: 0.7;
}

#message-input {
    flex: 1;
    padding: 12px 16px;
    background: var(--input-bg);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    color: var(--text-white);
    font-size: 15px;
    min-width: 0;
}

#message-input:focus {
    outline: none;
    border-color: var(--message-sent);
}

.send-btn {
    padding: 10px 24px;
    background: var(--message-sent);
    border: none;
    border-radius: 20px;
    color: var(--text-white);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
}

.send-btn:hover {
    opacity: 0.9;
}

/* Reaction Popup */
.reaction-popup {
    position: fixed;
    background: var(--sidebar-bg);
    padding: 10px;
    border-radius: 30px;
    display: flex;
    gap: 5px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    z-index: 1000;
    max-width: 90vw;
}

.reaction-btn {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    transition: transform 0.2s;
}

.reaction-btn:hover {
    transform: scale(1.2);
}

/* Message Options Menu */
.message-options {
    position: fixed;
    background: var(--sidebar-bg);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 5px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    z-index: 1000;
    min-width: 120px;
}

.option-btn {
    display: block;
    width: 100%;
    padding: 10px 20px;
    background: none;
    border: none;
    color: var(--text-white);
    text-align: left;
    cursor: pointer;
    border-radius: 5px;
    transition: background 0.2s;
}

.option-btn:hover {
    background: var(--input-bg);
}

.option-btn[data-action="delete"] {
    color: #ff3b30;
}

/* Reply Preview Bar */
.reply-preview {
    padding: 10px 20px;
    background: var(--input-bg);
    border-top: 1px solid var(--border-color);
    display: none;
}

.reply-preview:not(.hidden) {
    display: block;
}

.reply-preview-content {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.reply-preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.reply-to-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--message-sent);
}

.reply-preview-text {
    font-size: 13px;
    color: #cccccc;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

.cancel-reply-btn {
    background: none;
    border: none;
    color: var(--text-white);
    font-size: 24px;
    cursor: pointer;
    padding: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
}

.cancel-reply-btn:hover {
    opacity: 1;
}

/* Replied Message Display */
.message-reply-context {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 8px 10px;
    border-radius: 8px;
    margin-bottom: 6px;
    border-left: 3px solid rgba(255, 255, 255, 0.5);
    cursor: pointer;
}

.message-reply-context:hover {
    background: rgba(255, 255, 255, 0.25);
}

.reply-context-name {
    display: none;
}

.reply-context-text {
    font-size: 13px;
    color: #000000;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.message.sent .reply-context-text {
    color: #ffffff;
}

.message.received .message-reply-context {
    border-left-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.2);
}

.message.received .message-reply-context:hover {
    background: rgba(255, 255, 255, 0.3);
}

.message.received .reply-context-text {
    color: #ffffff;
}

/* Mobile Responsive */
@media (min-width: 768px) {
    .user-list-container {
        width: 350px;
        min-width: 350px;
    }
}

@media (max-width: 767px) {
    body {
        align-items: stretch;
    }

    #calculator-view {
        max-width: 100%;
        width: 100%;
        height: 100%;
    }

    #chat-app {
        width: 100%;
        height: 100%;
        position: fixed;
        top: 0;
        left: 0;
    }

    .chat-container {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .user-list-container {
        position: absolute;
        width: 100%;
        height: 100%;
        z-index: 1;
        transition: transform 0.3s ease;
    }

    .chat-window-container {
        position: absolute;
        width: 100%;
        height: 100%;
        z-index: 2;
        transform: translateX(100%);
        transition: transform 0.3s ease;
    }

    .chat-window-container.active {
        transform: translateX(0);
    }

    .back-btn {
        display: block;
    }

    .messages-container {
        padding: 15px 10px;
    }

    .message-input-container {
        padding: 10px 15px;
        gap: 8px;
    }

    .chat-header {
        padding: 15px;
    }

    .chat-window-header {
        padding: 12px 15px;
    }

    .send-btn {
        padding: 10px 20px;
        font-size: 14px;
    }

    #message-input {
        font-size: 16px;
    }

    .user-list {
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }
}

/* Scrollbar Styling */
::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: var(--bg-dark);
}

::-webkit-scrollbar-thumb {
    background: var(--btn-number);
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--btn-function);
}